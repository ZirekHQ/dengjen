{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>austek/renovate-config"
  ],
  "ignoreDeps": [
    "test:integrationTest"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^\\.github/workflows/.+\\.ya?ml$/"
      ],
      "matchStrings": [
        "maturin-version: (?<currentValue>v\\d+\\.\\d+\\.\\d+)"
      ],
      "depNameTemplate": "maturin",
      "packageNameTemplate": "PyO3/maturin",
      "datasourceTemplate": "github-releases"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^\\.github/workflows/.+\\.ya?ml$/"
      ],
      "matchStrings": [
        "dtolnay/rust-toolchain@(?<currentDigest>[a-f0-9]{40}) # (?<currentValue>stable|nightly)"
      ],
      "depNameTemplate": "dtolnay/rust-toolchain",
      "packageNameTemplate": "https://github.com/dtolnay/rust-toolchain",
      "datasourceTemplate": "git-refs"
    }
  ],
  "pip-compile": {
    "managerFilePatterns": [
      "/^benchmarks/stt/requirements\\.txt$/"
    ]
  },
  "packageRules": [
    {
      "description": "the STT benchmark lock is compiled from requirements.in, so pip-compile bumps the .in and recompiles instead of editing the hashed .txt",
      "matchManagers": [
        "pip_requirements"
      ],
      "matchFileNames": [
        "benchmarks/stt/requirements.txt"
      ],
      "enabled": false
    },
    {
      "description": "dtolnay/rust-toolchain pins a rolling branch, which the git-refs custom manager tracks",
      "matchManagers": [
        "github-actions"
      ],
      "matchDepNames": [
        "dtolnay/rust-toolchain"
      ],
      "enabled": false
    },
    {
      "description": "workspace-hack is generated by cargo hakari; never bump it by hand",
      "matchFileNames": [
        "crates/workspace-hack/**"
      ],
      "enabled": false
    },
    {
      "description": "onnxruntime and torch publish no Python 3.15 wheels, which the Rust lint and STT benchmark jobs install",
      "matchDepNames": [
        "python"
      ],
      "allowedVersions": "<3.15"
    },
    {
      "description": "jgit is pinned to the 5.x line for the Gradle buildscript classpath",
      "matchPackageNames": [
        "org.eclipse.jgit:org.eclipse.jgit"
      ],
      "enabled": false
    },
    {
      "description": "git-versioning 7 calls PersonIdent.getWhenAsInstant, which the jgit 5.x buildscript pin lacks",
      "matchPackageNames": [
        "/me\\.qoomon\\.git-versioning/"
      ],
      "allowedVersions": "<7"
    },
    {
      "description": "the Go linux natives build on ubuntu-24.04 to match the glibc of the verify job",
      "matchFileNames": [
        ".github/workflows/publish-go.yaml"
      ],
      "matchDepNames": [
        "ubuntu"
      ],
      "enabled": false
    },
    {
      "description": "AGP checks a minimum Gradle version and the Gradle wrapper update runs against the AGP in the tree, so they must land together",
      "matchFileNames": [
        "bindings/android/**"
      ],
      "matchDepNames": [
        "com.android.library",
        "gradle"
      ],
      "groupName": "android gradle plugin and gradle wrapper"
    }
  ],
  "gitIgnoredAuthors": [
    "natives-bot@users.noreply.github.com"
  ]
}
