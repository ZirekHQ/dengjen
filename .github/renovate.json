{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>austek/renovate-config"
  ],
  "ignoreDeps": [
    "test:integrationTest"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^\\.github/workflows/.+\\.ya?ml$/"
      ],
      "matchStrings": [
        "maturin-version: (?<currentValue>v\\d+\\.\\d+\\.\\d+)"
      ],
      "depNameTemplate": "maturin",
      "packageNameTemplate": "PyO3/maturin",
      "datasourceTemplate": "github-releases"
    }
  ],
  "packageRules": [
    {
      "description": "workspace-hack is generated by cargo hakari; never bump it by hand",
      "matchFileNames": [
        "crates/workspace-hack/**"
      ],
      "enabled": false
    },
    {
      "description": "jgit is pinned to the 5.x line for the Gradle buildscript classpath",
      "matchPackageNames": [
        "org.eclipse.jgit:org.eclipse.jgit"
      ],
      "enabled": false
    }
  ]
}
