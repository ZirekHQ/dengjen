{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>austek/renovate-config"
  ],
  "ignoreDeps": [
    "test:integrationTest"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^\\.github/workflows/.+\\.ya?ml$/"
      ],
      "matchStrings": [
        "maturin-version: (?<currentValue>v\\d+\\.\\d+\\.\\d+)"
      ],
      "depNameTemplate": "maturin",
      "packageNameTemplate": "PyO3/maturin",
      "datasourceTemplate": "github-releases"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^\\.github/workflows/.+\\.ya?ml$/"
      ],
      "matchStrings": [
        "dtolnay/rust-toolchain@(?<currentDigest>[a-f0-9]{40}) # (?<currentValue>stable|nightly)"
      ],
      "depNameTemplate": "dtolnay/rust-toolchain",
      "packageNameTemplate": "https://github.com/dtolnay/rust-toolchain",
      "datasourceTemplate": "git-refs"
    }
  ],
  "packageRules": [
    {
      "description": "dtolnay/rust-toolchain pins a rolling branch, which the git-refs custom manager tracks",
      "matchManagers": [
        "github-actions"
      ],
      "matchDepNames": [
        "dtolnay/rust-toolchain"
      ],
      "enabled": false
    },
    {
      "description": "workspace-hack is generated by cargo hakari; never bump it by hand",
      "matchFileNames": [
        "crates/workspace-hack/**"
      ],
      "enabled": false
    },
    {
      "description": "onnxruntime and torch publish no Python 3.15 wheels, which the Rust lint and STT benchmark jobs install",
      "matchDepNames": [
        "python"
      ],
      "allowedVersions": "<3.15"
    },
    {
      "description": "jgit is pinned to the 5.x line for the Gradle buildscript classpath",
      "matchPackageNames": [
        "org.eclipse.jgit:org.eclipse.jgit"
      ],
      "enabled": false
    }
  ],
  "gitIgnoredAuthors": [
    "natives-bot@users.noreply.github.com"
  ]
}
