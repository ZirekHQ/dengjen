<?xml version="1.0" encoding="utf-8"?>
<!-- SignPath artifact configuration "sapi-installer": the Inno Setup installer, which already holds
     the signed DLL. Kept here for review; SignPath uses the copy saved in its project. -->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <parameters>
    <parameter name="version" required="true" />
  </parameters>
  <zip-file>
    <pe-file path="dengjen-sapi-${version}-x64-setup.exe" product-name="Dengjen" product-version="${version}">
      <authenticode-sign />
    </pe-file>
  </zip-file>
</artifact-configuration>
